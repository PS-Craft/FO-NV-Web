 void me_WaitForCompletion(FnvCpu& s) { M32(A(2)) = 0; RET(0x80040013u, 3); }
 
+// Release on any of the graph's six interfaces. When the game holds none of them any more and the track still runs,
+// the page's player stops and frees it (otherwise every finished graph left a playing <audio> behind) and the filter
+// gets its reference back. The graph's own few hundred bytes stay, as before: freeing them is not worth the risk of a
+// late call through a stale pointer.
+// The game holds obj[0] from CoCreateInstance and the others only through QueryInterface, so the others count as
+// free at a reference count of 1 (their own).
+void graph_release(FnvCpu& s)
+{
+    uint32_t obj = A(0);
+    Graph* g = G(s);
+    uint32_t r = M32(obj + 8) ? --M32(obj + 8) : 0;
+    bool held = M32(g->obj[0] + 8) != 0;
+    for (int i = 1; i < 6 && !held; ++i) held = M32(g->obj[i] + 8) > 1;
+    if (!held)
+    {
+        int state;
+        {
+            std::lock_guard<std::mutex> lk(g->mx);
+            state = g->state;
+            g->state = 0;
+        }
+        if (state != 0) sink((uintptr_t)g, 3, g->file, g->volume, 0);
+        uint32_t f = g->filter;
+        g->filter = 0;
+        if (f) filter_call(s, f, 2);
+    }
+    RET(r, 1);
+}
