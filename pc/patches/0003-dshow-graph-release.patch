 // IFilterGraph / IGraphBuilder
-void gb_AddFilter(FnvCpu& s) { Graph* g = G(s); g->filter = A(1); if (A(1)) ++M32(A(1) + 8); RET(0, 3); }
+// The filter is the game's own object (its music decoder, holding the track). Like DirectShow, the graph takes a
+// reference through the filter's own AddRef and gives it back through its Release when the game lets go of the
+// graph. Before, the graph incremented the word at +8 (our COM layout, not the game's), so the filter and its track
+// were never freed: about 4 MB per music start, measured on the death screen (it restarts the music every 6 s),
+// until the tab ran out of memory.
+uint32_t filter_call(FnvCpu& s, uint32_t f, int slot)          // IUnknown: 1 AddRef, 2 Release
+{
+    uint32_t args[1] = {f};
+    return fnv_guest_call(s, M32(M32(f) + 4u * slot), args, 1);
+}
+void gb_AddFilter(FnvCpu& s)
+{
+    Graph* g = G(s);
+    uint32_t f = A(1);
+    if (f && !g->filter) { g->filter = f; filter_call(s, f, 1); }
+    RET(0, 3);
+}
 
