 thread_local HostThread* t_ht;
 HostThread* g_main_ht;                          // the game's main thread, for fnv_dump_state after a wasm trap
 
+// Large blocks (the game's VirtualAlloc reservations: 200, 64, 16 MB at start-up) come straight from the end of the
+// heap: malloc here never gives memory back below its break (dlmalloc MORECORE_CANNOT_TRIM), so the linear memory past
+// it has never been written and is zero. Zeroing it again, as before, made every page of those reservations resident at
+// once, used or not, which counts against the tab's memory on an iPad. A released large block is kept for a later
+// request of the same size and zeroed then.
+std::mutex g_big_mx;
+std::map<uint32_t, uint32_t> g_big;                    // large blocks from the break: address -> size
+std::multimap<uint32_t, uint32_t> g_big_free;          // released ones: size -> address
+const uint32_t kBigBlock = 8u << 20;
 uint32_t galloc(uint32_t size)
 {
-    void* p = aligned_alloc(65536, (size + 65535) & ~65535u);
+    uint32_t rs = (size + 65535) & ~65535u;
+    if (rs >= kBigBlock)
+    {
+        std::lock_guard<std::mutex> lk(g_big_mx);
+        auto it = g_big_free.find(rs);
+        if (it != g_big_free.end())
+        {
+            uint32_t a = it->second;
+            g_big_free.erase(it);
+            memset((void*)(uintptr_t)a, 0, rs);
+            return a;
+        }
+        uintptr_t brk = (uintptr_t)sbrk(0);
+        uintptr_t pad = (65536 - (brk & 65535)) & 65535;
+        void* p = sbrk((intptr_t)(pad + rs));
+        if (p != (void*)-1)
+        {
+            uint32_t a = (uint32_t)((uintptr_t)p + pad);
+            g_big[a] = rs;
+            return a;
+        }
+    }
+    void* p = aligned_alloc(65536, rs);
     memset(p, 0, size);
     return (uint32_t)(uintptr_t)p;
 }
+// free a galloc block (VirtualFree MEM_RELEASE)
+void gfree(uint32_t a)
+{
+    {
+        std::lock_guard<std::mutex> lk(g_big_mx);
+        auto it = g_big.find(a);
+        if (it != g_big.end()) { g_big_free.insert({it->second, a}); return; }
+    }
+    free((void*)(uintptr_t)a);
+}
 
