+// read-ahead for seq_file(): one helper thread fetches the blocks after the one just read into the shared cache
+struct Ahead { std::string path; int64_t blk, size; };
+std::mutex g_ah_mx;
+std::condition_variable g_ah_cv;
+std::vector<Ahead> g_ah_q;
+bool g_ah_started;
+void fs_ahead(const std::string& path, int64_t blk, int64_t size)
+{
+    const int64_t bs = file_block(path);
+    for (int64_t k = blk + 1; k <= blk + 2 && k * bs < size; ++k)
+    {
+        {
+            std::lock_guard<std::mutex> lk(g_bc_mx);
+            if (g_blocks.count(path + '#' + std::to_string(k))) continue;      // cached or being fetched
+        }
+        std::lock_guard<std::mutex> lk(g_ah_mx);
+        bool queued = false;
+        for (auto& a : g_ah_q) queued |= a.blk == k && a.path == path;
+        if (queued || g_ah_q.size() >= 8) continue;
+        g_ah_q.push_back({path, k, size});
+        if (!g_ah_started)
